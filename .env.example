# BlendNBubbles environment variables (CRA exposes only REACT_APP_* to the browser).
# Copy to `.env.production` (or `.env`) and fill in real values, then rebuild.

# Apps Script web-app URL that appends spin-wheel results to a Google Sheet.
# Setup steps are documented at the bottom of src/SpinWheel.js. Leave empty
# to disable the audit log without breaking the wheel.
REACT_APP_SPIN_WEBHOOK_URL=

# Sales dashboard data service (services/reports).
# Not a secret: this is a public endpoint that refuses every request without a
# valid bearer token. The token is a Cloudflare Worker secret and is never built
# into the bundle — you paste it into /reports once and the browser keeps it.
# Without this set at build time, /reports reports itself unconfigured.
REACT_APP_REPORTS_URL=

# Partner portal data service (services/partners).
# Same arrangement, separate Worker and separate token: the extract holds
# customer names and phone numbers, so a partner-token rotation must not black
# out the sales dashboard. Without this set at build time, /partners reports
# itself unconfigured and renders nothing.
REACT_APP_PARTNERS_URL=
